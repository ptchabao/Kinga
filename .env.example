# Core
NODE_ENV=production
SECRET_KEY=change-me
ENCRYPTION_KEY=change-me

# Database
DATABASE_URL=postgresql://safiri:safiri_password@db:5432/safiri_db
POSTGRES_USER=safiri
POSTGRES_PASSWORD=safiri_password
POSTGRES_DB=safiri_db

# Redis
REDIS_URL=redis://redis:6379

# API
API_HOST=0.0.0.0
API_PORT=8000

# UI
NEXT_PUBLIC_API_URL=http://kinga-api:8000
ADMIN_UI_PORT=3000
WEB_UI_PORT=3001

# Optional LLM providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO
